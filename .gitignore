# --- Datos: nunca se versionan (se descargan de Kaggle a data/raw) ---
# Solo se suben los .gitkeep que mantienen la estructura de carpetas.
data/**
!data/**/
!data/**/.gitkeep

# Archivos de datos y documentos sueltos, en cualquier carpeta
*.csv
*.zip
*.parquet
*.xlsx
*.pdf
*.docx
# Excepción: los pedidos ya puntuados del modo web de la app (python -m app.datos_web)
!app/datos_web/*.parquet

# --- Salidas generadas ---
reports/*.json
models/

# --- Python / Jupyter ---
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.ipynb_checkpoints/

# --- Entorno local y herramientas personales ---
.env
.vscode/
.idea/
.claude/
.agents/
.DS_Store
Thumbs.db
